# Copie para .env e preencha. O .env fica fora do Git (veja .gitignore) e deve ter permissão 600 no servidor.
# O Next (npm run start/dev) e os scripts (npm run db:migrate, backup, admin:senha…) leem este arquivo.

# PostgreSQL de produção (Neon ou Postgres no próprio VPS). Formato:
#   postgresql://USUARIO:SENHA@HOST/BANCO?sslmode=require
# Vazia = PostgreSQL embutido (PGlite) em ./.data/pglite, só para desenvolvimento local.
DATABASE_URL=

# Conexões do pool por processo (padrão 10).
DB_POOL_MAX=

# Pasta do PGlite quando DATABASE_URL está vazia (padrão: ./.data/pglite).
PGLITE_DATA_DIR=

# URL pública do app (com https em produção, sem barra no fim). Usada nos links de acesso gerados
# pelo administrador e para liberar as Server Actions.
APP_URL=http://localhost:3000

# Outros hosts liberados para Server Actions, separados por vírgula (opcional).
ORIGENS_EXTRAS=

# Porta e endereço do `npm run start` (padrão 3000 e 127.0.0.1: só o Nginx acessa). Lidos pelo systemd
# (EnvironmentFile) antes do Next subir; se rodar `npm run start` à mão, exporte-os no shell.
PORT=3000
HOST=127.0.0.1

# Hosts extras aceitos pelo `npm run dev` além de localhost (opcional, ex.: 192.168.0.10).
DEV_ORIGENS=

# Bloco "Demonstração — entrar como" na tela de login (login com um clique, senha do seed).
# Local sem DATABASE_URL: aparece por padrão. Com DATABASE_URL/produção: só com "true". Nunca use "true" com dados reais.
EXIBIR_DEMO=

# Segredo da rota /api/cron/verificacoes (avisos de prazo e lembretes agendados).
# Sem ele a rota responde 503. Chamada: Authorization: Bearer <CRON_SECRET>. Veja docs/operacao.md.
CRON_SECRET=

# Entrada pelo Portal NORTE (NORTE-App-Hub): o portal abre /api/auth/portal?portal_sso=<token>.
# PORTAL_SSO_SECRET = SESSION_SECRET do hub (32+ caracteres). Vazio = entrada pelo portal desligada.
# PORTAL_URL = endereço do portal, só para o link "Entre pelo Portal NORTE" na tela de login.
PORTAL_SSO_SECRET=
PORTAL_URL=

# Quantos proxies ficam na frente do app (padrão 1 = o Nginx do VPS). O IP do limite de tentativas de login é
# o n-ésimo valor do fim do x-forwarded-for. Com Cloudflare + Nginx, use 2. Veja docs/operacao.md.
PROXIES_CONFIAVEIS=

# Backup (npm run backup): pasta, quantos manter e modo (auto | pg_dump | dados).
BACKUP_DIR=
BACKUP_MANTER=14
BACKUP_MODO=auto
