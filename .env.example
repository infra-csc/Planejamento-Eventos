# Deixe vazio para usar o PostgreSQL embutido (PGlite) em ./.data/pglite (desenvolvimento local).
# No Replit, use o PostgreSQL do próprio Replit: a variável DATABASE_URL já é injetada automaticamente.
DATABASE_URL=

# Pasta do PGlite quando DATABASE_URL está vazia (padrão: ./.data/pglite).
PGLITE_DATA_DIR=

# URL pública do app. Usada nos links de acesso gerados pelo administrador e para liberar as Server Actions.
APP_URL=http://localhost:3000

# Bloco "Demonstração — entrar como" na tela de login (login com um clique, senha do seed).
# Local: aparece por padrão. Replit/produção: só com "true". Nunca use "true" com dados reais.
EXIBIR_DEMO=
