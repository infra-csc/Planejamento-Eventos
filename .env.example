# Deixe vazio para usar o PostgreSQL embutido (PGlite) em ./.data/pglite (desenvolvimento local).
# No Replit, use o PostgreSQL do próprio Replit: a variável DATABASE_URL já é injetada automaticamente.
DATABASE_URL=

# Segredo usado para assinar tokens de recuperação de senha. Gere um valor aleatório em produção.
APP_SECRET=troque-este-valor-em-producao

# URL pública (usada nos links de recuperação de senha)
APP_URL=http://localhost:3000
