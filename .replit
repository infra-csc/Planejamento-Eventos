modules = ["nodejs-24", "postgresql-16"]
# Produção também no workspace: o modo dev compila cada tela na primeira visita e fica 10-20x mais lento.
run = "npm run setup && npm run build && npm run start"

[nix]
channel = "stable-24_11"

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "npm ci && npm run build"]
run = ["sh", "-c", "npm run db:migrate && npm run start"]

# Uma porta só: o app escuta na 3000 e o Replit publica na porta padrão (sem ":porta" na URL).
[[ports]]
localPort = 3000
externalPort = 80

[env]
PORT = "3000"
# Login de demonstração com um clique. Qualquer pessoa com o link entra como qualquer perfil:
# troque para "false" (ou apague a linha) assim que houver dados reais.
EXIBIR_DEMO = "true"

# Botão Run. O projeto usa npm (package-lock.json); não trocar para pnpm.
[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run setup && npm run build && npm run start"
waitForPort = 3000

[workflows.workflow.metadata]
outputType = "webview"
