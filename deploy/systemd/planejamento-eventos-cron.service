# Avisos agendados (SLA, prazos, lembretes): chama /api/cron/verificacoes.
[Unit]
Description=Norte Mkt - verificações agendadas (Planejamento de Eventos)
After=planejamento-eventos.service

[Service]
Type=oneshot
User=eventos
Group=eventos
WorkingDirectory=/opt/planejamento-eventos
ExecStart=/opt/planejamento-eventos/deploy/cron-verificacoes.sh
