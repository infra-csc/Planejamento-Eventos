{
  "name": "norte-planejamento-eventos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "rm -rf .next/cache/fetch-cache && next build",
    "start": "next start -H ${HOST:-127.0.0.1} -p ${PORT:-3000}",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "db:reset": "tsx --env-file-if-exists=.env scripts/reset.ts",
    "setup": "npm run db:migrate && npm run db:seed && npm run importar:catalogo && npm run importar:arena && npm run db:dados",
    "db:dados": "tsx --env-file-if-exists=.env scripts/registrar-pre-reuniao.ts",
    "test:smoke": "tsx --env-file-if-exists=.env scripts/smoke.ts",
    "test:e2e": "playwright test",
    "importar:catalogo": "tsx --env-file-if-exists=.env scripts/importar-catalogo.ts",
    "importar:eventos": "tsx --env-file-if-exists=.env scripts/importar-eventos-os.ts",
    "importar:arena": "tsx --env-file-if-exists=.env scripts/importar-arena-eco-run.ts",
    "admin:senha": "tsx --env-file-if-exists=.env scripts/admin-senha.ts",
    "backup": "tsx --env-file-if-exists=.env scripts/backup.ts",
    "restaurar": "tsx --env-file-if-exists=.env scripts/restaurar.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/roboto-mono": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "next": "^16.4.3",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "three": "^0.180.0",
    "tsx": "^4.23.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.13.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.180.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
